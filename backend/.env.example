# Used when the API runs on the host, against Mongo and Redis on localhost.
# Compose does not read these URLs. Inside Compose the API uses mongo and redis
# by service name, and the frontend uses http://api:3000.
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/easygenerator
JWT_SECRET=replace-with-at-least-32-random-characters
REDIS_URL=redis://127.0.0.1:6379
RATE_LIMIT_MAX=100
RATE_LIMIT_TTL_SECONDS=60
SESSION_SECRET=easygenerator-dev-session-secret
